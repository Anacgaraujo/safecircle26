rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && uid() == userId;

      match /private/{doc} {
        allow read, write: if signedIn() && uid() == userId;
      }

      match /contacts/{contactId} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    match /circles/{circleId} {
      allow read: if signedIn() && (
        uid() == resource.data.ownerId ||
        uid() in resource.data.memberIds ||
        uid() in resource.data.get('invitedUids', [])
      );
      allow create: if signedIn() && request.resource.data.ownerId == uid();
      allow update: if signedIn() && (
        uid() == resource.data.ownerId ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'memberIds', 'invitedUids']) &&
          (
            (uid() in request.resource.data.memberIds && !(uid() in resource.data.memberIds)) ||
            (!(uid() in request.resource.data.memberIds) && uid() in resource.data.memberIds)
          )
        )
      );
      allow delete: if signedIn() && uid() == resource.data.ownerId;
    }

    match /invites/{inviteId} {
      allow read: if signedIn() && (
        resource.data.toEmail == request.auth.token.email ||
        resource.data.fromUid == uid()
      );
      allow create: if signedIn() && request.resource.data.fromUid == uid();
      allow update, delete: if signedIn() && (
        resource.data.toEmail == request.auth.token.email ||
        resource.data.fromUid == uid()
      );
    }

    match /journeys/{journeyId} {
      allow read: if signedIn() && (
        uid() == resource.data.ownerId ||
        uid() in resource.data.watcherIds
      );
      allow create: if signedIn() && request.resource.data.ownerId == uid();
      allow update, delete: if signedIn() && uid() == resource.data.ownerId;
    }

    match /status/{userId} {
      allow read: if signedIn() && (
        uid() == userId || uid() in resource.data.get('viewerIds', [])
      );
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.get('viewerIds', []).hasAny([uid()]);
      allow delete: if signedIn() && uid() == userId;
    }

    match /places/{placeId} {
      allow read: if signedIn() && uid() in resource.data.get('viewerIds', []);
      allow create: if signedIn()
        && request.resource.data.get('viewerIds', []).hasAny([uid()])
        && request.resource.data.createdBy == uid();
      allow update, delete: if signedIn() && uid() in resource.data.get('viewerIds', []);
    }

    match /trips/{tripId} {
      allow read: if signedIn() && (
        resource.data.userId == uid() || uid() in resource.data.get('viewerIds', [])
      );
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow update, delete: if signedIn() && resource.data.userId == uid();
    }

    match /activity/{eventId} {
      allow read: if signedIn() && (
        resource.data.userId == uid() || uid() in resource.data.get('viewerIds', [])
      );
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow update, delete: if signedIn() && resource.data.userId == uid();
    }

    match /alerts/{alertId} {
      allow read: if signedIn() && (
        uid() == resource.data.fromUid ||
        uid() in resource.data.watcherIds
      );
      allow create: if signedIn() && request.resource.data.fromUid == uid();
      allow update: if signedIn() && (
        uid() == resource.data.fromUid ||
        (
          uid() in resource.data.watcherIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved'])
        )
      );
      allow delete: if signedIn() && uid() == resource.data.fromUid;
    }
  }
}
