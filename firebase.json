{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.local",
        "test"
      ]
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "safe-circle26",
          "appId": "1:777613494014:android:a50b16411686ba6c6287af",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "safe-circle26",
          "configurations": {
            "android": "1:777613494014:android:a50b16411686ba6c6287af",
            "ios": "1:777613494014:ios:34e9149d141b44a36287af",
            "web": "1:777613494014:web:529b99da6ee6b1d76287af"
          }
        }
      },
      "ios": {
        "default": {
          "projectId": "safe-circle26",
          "appId": "1:777613494014:ios:34e9149d141b44a36287af",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      }
    }
