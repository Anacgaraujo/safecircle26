# Non-secret settings for the Cloud Functions (committed).
# Twilio keys are secrets: set them with `firebase functions:secrets:set`.

# Link included in invitation texts (App Store / Play Store / website).
# Leave empty until you have one.
APP_INVITE_URL=https://safecircle.me

# Cost guards: how many invitation texts can go out per day (UTC).
DAILY_TEXTS_PER_USER=20
DAILY_TEXTS_TOTAL=200

# Minimum wait before "Resend invitation" can text the same number again.
RESEND_COOLDOWN_MINUTES=5

# Emergency texts (SOS, panic PIN, missed check-in, all-clear) have their own
# budget so invitations can never block them.
EMERGENCY_RECIPIENTS_MAX=15
EMERGENCY_TEXTS_PER_USER=60
EMERGENCY_TEXTS_TOTAL=1000
